[Unit]
Description=Spark Hub Dashboard
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=dgx-3
WorkingDirectory=/home/dgx-3/Documents/spark-hub
ExecStart=/home/dgx-3/Documents/spark-hub/venv/bin/python app.py
Restart=always
RestartSec=5
Environment=HOME=/home/dgx-3

[Install]
WantedBy=multi-user.target
