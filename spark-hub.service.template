[Unit]
Description=Spark Hub Dashboard
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/venv/bin/python app.py
Restart=always
RestartSec=5
StartLimitBurst=10
StartLimitIntervalSec=60
Environment=HOME=__HOME__
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Tillader systemctl --user-kald (restart af vLLM/LiteLLM user units)
# %U expanderer til UID af User= ovenfor; kræver loginctl enable-linger __USER__
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=multi-user.target
